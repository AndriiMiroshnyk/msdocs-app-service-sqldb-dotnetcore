    {
      "type": 1,
      "content": {
        "json": "## Application Insights"
      },
      "name": "text - 26"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppRequests\r\n| where AppRoleName == \"{AppRole}\"\r\n| extend Weight = tolong(coalesce(ItemCount, 1))\r\n| summarize\r\n    Requests = sum(Weight),\r\n    Failures = sumif(Weight, Success == false)\r\n    by Name\r\n| where Failures > 0\r\n| extend FailureRatePct = round(100.0 * Failures / Requests, 2)\r\n| order by Failures desc",
        "size": 0,
        "title": "Failing routes",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.OperationalInsights/workspaces/example-app-logs"
        ],
        "visualization": "table"
      },
      "name": "query - 21"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppRequests\r\n| where AppRoleName == \"{AppRole}\"\r\n| extend Weight = tolong(coalesce(ItemCount, 1))\r\n| summarize\r\n    Requests = sum(Weight),\r\n    P50_ms = percentilew(DurationMs, Weight, 50),\r\n    P95_ms = percentilew(DurationMs, Weight, 95),\r\n    P99_ms = percentilew(DurationMs, Weight, 99)\r\n    by Name\r\n| order by P95_ms desc",
        "size": 0,
        "title": "Latency percentiles by route",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.OperationalInsights/workspaces/example-app-logs"
        ],
        "visualization": "table"
      },
      "name": "query - 22"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "AppExceptions\r\n| where AppRoleName == \"{AppRole}\"\r\n| project\r\n    TimeGenerated,\r\n    ExceptionType,\r\n    OuterMessage,\r\n    OperationId\r\n| top 50 by TimeGenerated desc",
        "size": 0,
        "title": "Recent exceptions",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.OperationalInsights/workspaces/example-app-logs"
        ],
        "visualization": "table"
      },
      "name": "query - 23"
    }
