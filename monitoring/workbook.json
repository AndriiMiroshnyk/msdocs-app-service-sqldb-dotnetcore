    {
      "type": 1,
      "content": {
        "json": "## Application health"
      },
      "name": "text - 1"
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "union withsource=TableName AppRequests, AppDependencies, AppExceptions\r\n| where AppRoleName == \"{AppRole}\"\r\n| extend Weight = tolong(coalesce(ItemCount, 1))\r\n| summarize\r\n    FailedRequests = sumif(Weight,\r\n        TableName == \"AppRequests\" and Success == false),\r\n    Exceptions = sumif(Weight,\r\n        TableName == \"AppExceptions\"),\r\n    DependencyFailures = sumif(Weight,\r\n        TableName == \"AppDependencies\" and Success == false),\r\n    LastTelemetry = max(TimeGenerated)\r\n    | extend Counters = bag_pack(\r\n    \"Failed requests\", FailedRequests,\r\n    \"Exceptions\", Exceptions,\r\n    \"Dependency failures\", DependencyFailures)\r\n| mv-expand kind=array Counters\r\n| project\r\n    Signal = tostring(Counters[0]),\r\n    Value = tolong(Counters[1]),\r\n    LastTelemetry",
        "size": 0,
        "title": "Application failures and telemetry freshness",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/example-rg/providers/Microsoft.OperationalInsights/workspaces/example-app-logs"
        ],
        "visualization": "tiles",
        "sortBy": [],
        "tileSettings": {
          "titleContent": {
            "columnMatch": "Signal",
            "formatter": 1
          },
          "leftContent": {
            "columnMatch": "Value",
            "formatter": 12,
            "formatOptions": {
              "palette": "auto"
            },
            "numberFormat": {
              "unit": 17,
              "options": {
                "maximumSignificantDigits": 3,
                "maximumFractionDigits": 2
              }
            }
          },
          "secondaryContent": {
            "columnMatch": "LastTelemetry"
          },
          "showBorder": false
        }
      },
      "name": "query - 2"
    },
